# @AT_Music Server Environment Variables

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=<redacted>

# Redis (optional - remove for in-memory mode)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=<redacted>

# Last.fm API
LASTFM_API_KEY=<redacted>
LASTFM_API_SECRET=<redacted>

# Apple Music API (MusicKit developer token; generate via Apple Developer portal)
APPLE_MUSIC_DEVELOPER_TOKEN=<redacted>

# Database (for future implementation)
DATABASE_URL=<redacted>


# Spotify API (client credentials — get from developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# SoundCloud API (optional — client id used by the link resolver for stream URLs)
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id

# Audio recognition (OPTIONAL — off by default; fingerprint-grade identity
# confirmation for the link resolver. Metadata + ISRC matching works without
# these. Supply your own keys from audd.io or acrcloud.com.)
AUDD_API_TOKEN=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
